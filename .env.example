# Backend configuration. Copy to .env (never commit .env or key files).
PORT=3000
NODE_ENV=development
VAULT_ID=vault-1
# Daily withdrawal limit in taka; dollar and yuan withdrawals are converted at the app's rates.
DAILY_LIMIT_BDT=20000
# Either a path to a PEM file or the PEM itself with \n for new lines.
PHONE_PUBLIC_KEY=keys/phone-public.pem
BACKEND_PRIVATE_KEY=keys/backend-private.pem
# Optional: JSON note counts reported by the vault, e.g. {"BDT:1000":4,"USD:20":3}
# VAULT_INVENTORY=
